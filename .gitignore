# ---- Python ----
ai/.venv/
ai/venv/
ai/__pycache__/
ai/**/__pycache__/
ai/**/*.pyc
ai/.pytest_cache/
ai/.mypy_cache/
ai/*.egg-info/
__pycache__/
*.py[cod]
*$py.class
# Pytest also runs from the repo root in some flows (e.g. when the
# user picks the workspace as basetemp). The artifacts are pure cache
# / fixture scratch — never committed.
.pytest_cache/
.mypy_cache/
.tmp/
**/__pycache__/
**/*.pyc
**/*.pyo

# ---- Scratch tests / scripts / harnesses ----
# Forward-looking patterns: anything matching is treated as personal
# scratch and stays out of git. Promote a file to a real name (drop
# the prefix / suffix) when you want it tracked.
**/test_scratch_*.py
**/scratch_*.py
**/_scratch_*.py
**/_tmp_*.py
**/tmp_*.py
**/*_scratch.py
**/*_sandbox.py
# Non-Python scratch extensions seen in practice — interactive
# debugging dumps (lookup tables, page snapshots, intermediate
# selection lists). The repo-root prefix ``_scratch_`` is the
# convention so these don't collide with real project artefacts.
**/_scratch_*.json
**/_scratch_*.jsonl
**/_scratch_*.txt
**/_scratch_*.md
ai/scripts/_scratch/
ai/scripts/_drafts/
ai/eval/harness/_scratch/
ai/eval/harness/_drafts/
ai/tests/_scratch/
ai/tests/_drafts/
# Repo-root ad-hoc test runs / fixture sandboxes are local-only. Keep
# canonical test sources under ai/tests tracked.
/test/

# ---- Eval harness generated artifacts ----
# Reports change every run and should not be committed. Human-facing
# RAG ingestion state lives in docs/rag-ingestion-*.md; machine-readable
# report payloads are generated/local-only and may be regenerated or
# externalized as needed.
ai/eval/reports/*
!ai/eval/reports/rag-ingestion/
ai/eval/datasets/samples/

