frontend/app/dist/
frontend/app/.parcel-cache/
frontend/app/bundle.html
!frontend/app/package.json
!frontend/app/components.json
!frontend/app/tsconfig.json
!frontend/app/tsconfig.app.json
!frontend/app/tsconfig.node.json

# ---- Claude Code local state ----
# The whole .claude/ directory is per-user (settings, launch config,
# scheduled-task lockfiles, session logs, slash commands).
.claude/

# ---- Local agent tooling ----
# Per-user agent config, skills, and handoff notes should not be committed.
.agents/
AGENT.md

# ---- Java / Maven ----
core-api/target/
core-api/.mvn/wrapper/maven-wrapper.jar
core-api/build/
core-api/out/
core-api/**/*.class
core-api/logs/
